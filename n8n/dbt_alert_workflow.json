{
  "name": "dbt test alert",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "dbt-test-results",
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "dbt-test-results"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "a1b2c3d4-0002-4000-8000-000000000002",
              "leftValue": "={{ $json.body.failed }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Any test failed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "chatId": "REPLACE_WITH_YOUR_CHAT_ID",
        "text": "=⚠️ dbt tests failed ({{ $json.body.project }})\n\n{{ $json.body.failed }} of {{ $json.body.total }} tests failed.\n\n{{ $json.body.failures.slice(0, 10).map(f => '• ' + f.test + ' → ' + f.model + (f.failing_rows ? ' (' + f.failing_rows + ' rows)' : '')).join('\\n') }}",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML"
        }
      },
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Send Telegram alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [480, -80]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Any test failed?", "type": "main", "index": 0 }]]
    },
    "Any test failed?": {
      "main": [[{ "node": "Send Telegram alert", "type": "main", "index": 0 }], []]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
